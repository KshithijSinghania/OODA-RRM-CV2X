# OODA-RRM-CV2X .gitignore: code, configs, schemas and docs go to GitHub;
# datasets, simulation outputs, logs and model weights do not (see DATA.md).

# Python / editor clutter
__pycache__/
*.pyc
*.pyo
*.bak
*.bak_*
*.backup
.ipynb_checkpoints/
.vscode/
.idea/
.vsls.json
.DS_Store
Thumbs.db

# secrets (never commit)
.env
.env.*
*.pem
*.key
hf_token*
*credentials*

# Python environment and model weights
Fine-tune/ft/
Fine-tune/adapters/
Fine-tune/merged/
Fine-tune/gguf/
*.safetensors
*.gguf
*.pt
*.pth
*.bin
*.npz
*.ckpt

# datasets and generated data
datasets/*
!datasets/.gitkeep
OODA*/data/
OODA*/data_compact/
OODA*/data_compact2*/
*.jsonl
*.csv
# keep the three tiny schedule files the enforcer demo reads
!enforcer/sched_*.csv

# simulation outputs
ns3_exchange/results/
ns3_exchange/crashed/
ns3_exchange/schedules/
ns3_exchange/incoming/*
!ns3_exchange/incoming/cmp_runs.py
results/
enforcer/runs/
enforcer/runs_ctx/
Fine-tune/live_logs/
Fine-tune/logs/

# SUMO outputs (inputs such as .sumocfg, net, trips and ambulance.rou.xml are kept)
sumo/**/tripinfos.xml
sumo/**/edgeData.xml
sumo/**/stats.xml
sumo/**/*_tmp*.xml
sumo/**/fcd*.xml

# logs and archives
*.log
*.out
*.err
*.tgz
*.tar
*.tar.gz
*.zip
log_*.txt
obs_ids_*.txt
